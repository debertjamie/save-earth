<Window x:Class="SaveEarth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Earth"
        Height="650"
        Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10B981"
                Padding="20">
            <TextBlock Text="Save Earth"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                Margin="20">
            <StackPanel>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#9CA3AF"
                                Opacity="0.3"
                                BlurRadius="10"
                                ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Emisi Karbon Harian Anda"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#4B5563"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"/>
                        <TextBlock Text="12.5 kg CO₂"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#1F2937"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,5">
                            <Border Height="12"
                                    Background="#E5E7EB"
                                    CornerRadius="6"/>
                            <Border Height="12"
                                    Background="#10B981"
                                    CornerRadius="6"
                                    Width="200"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock Text="Masih di bawah batas aman harian"
                                FontSize="12"
                                Foreground="#6B7280"
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Challenge Singkat Hari Ini"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#1F2937"
                        Margin="0,0,0,15"/>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#9CA3AF"
                                Opacity="0.1"
                                BlurRadius="5"
                                ShadowDepth="1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Gunakan Transportasi Umum"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#1F2937"/>
                            <TextBlock Text="Target: Kurangi emisi kendaraan pribadi"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="0,2,0,5"/>
                            <TextBlock Text="Hemat ~2.4 kg CO₂"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#10B981"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Ambil"
                                Width="70"
                                Height="35"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#9CA3AF"
                                Opacity="0.1"
                                BlurRadius="5"
                                ShadowDepth="1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Makan Siang Tanpa Daging"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#1F2937"/>
                            <TextBlock Text="Target: Konsumsi bahan plant-based"
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="0,2,0,5"/>
                            <TextBlock Text="Hemat ~1.5 kg CO₂"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#10B981"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Ambil"
                                Width="70"
                                Height="35"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius"
                                            Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>