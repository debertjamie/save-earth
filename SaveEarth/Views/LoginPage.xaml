<Page x:Class="SaveEarth.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login"
      Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10B981"
                Padding="20">
            <TextBlock x:Name="HeaderText"
                       Text="Login"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="20">
            <Border Background="White"
                    CornerRadius="12"
                    Padding="25">
                <Border.Effect>
                    <DropShadowEffect Color="#9CA3AF"
                                      Opacity="0.3"
                                      BlurRadius="10"
                                      ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>

                    <StackPanel x:Name="NamePanel"
                                Visibility="Collapsed">
                        <TextBlock Text="Name"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox"
                                 Height="34"
                                 FontSize="14"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,15"/>
                    </StackPanel>

                    <TextBlock Text="Email"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="EmailBox"
                             Height="34"
                             FontSize="14"
                             Padding="6,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Password"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="34"
                                 FontSize="14"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,10"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="#EF4444"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Button x:Name="PrimaryButton"
                            Content="Login"
                            Height="44"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#10B981"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PrimaryButton_Click"
                            Margin="0,0,0,15">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="ToggleButton"
                            Content="Need an account? Register"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#10B981"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="ToggleButton_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
