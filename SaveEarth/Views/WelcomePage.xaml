<Page x:Class="SaveEarth.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Welcome"
      Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10B981"
                Padding="20">
            <TextBlock Text="🌍 Save Earth"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="20"
                    VerticalAlignment="Center">

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,30">
                <Border.Effect>
                    <DropShadowEffect Color="#9CA3AF"
                                      Opacity="0.3"
                                      BlurRadius="10"
                                      ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Track your carbon footprint"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Log daily activities, see your emissions, earn points and take on challenges to live greener."
                               FontSize="14"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="StartButton"
                    Content="LOGIN TO START 🚀"
                    Height="50"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#10B981"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="StartButton_Click"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="CtaScale"
                                    ScaleX="1.0"
                                    ScaleY="1.0"/>
                </Button.RenderTransform>
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever"
                                        AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="CtaScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.05"
                                                 Duration="0:0:0.8"/>
                                <DoubleAnimation Storyboard.TargetName="CtaScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.05"
                                                 Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </StackPanel>
    </Grid>
</Page>
